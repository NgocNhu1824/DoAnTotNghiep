# Application
NODE_ENV=development
PORT=3000
APP_NAME=Classroom Management System

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/classroom_management?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-public-api-domain.com/api/auth/google/callback

# Frontend URL (for CORS and redirect)
FRONTEND_URL=http://localhost:3001
MOBILE_APP_URL=smartlockermobile://auth/callback

# Password reset email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-email@gmail.com

# Optional secret added when hashing reset token
RESET_PASSWORD_TOKEN_PEPPER=change-this-secret-pepper

# Face embedding and verification
# Run local InsightFace provider from backendAPI/embedding-provider (default port 8008).
FACE_EMBEDDING_PROVIDER_URL=http://127.0.0.1:8008/v1/face/embedding
FACE_EMBEDDING_PROVIDER_API_KEY=
# Timeout when calling external embedding provider.
FACE_EMBEDDING_PROVIDER_TIMEOUT_MS=10000
# Set false to force real provider usage (recommended for production/UAT).
FACE_EMBEDDING_ALLOW_DEV_FALLBACK=false
# Verification passes when cosine similarity >= threshold (0 < value <= 1).
FACE_VERIFY_SIMILARITY_THRESHOLD=0.88
# Register is rejected if too similar to another user template.
FACE_REGISTER_DUPLICATE_SIMILARITY_THRESHOLD=0.94
# Face scan session + liveness controls
FACE_SCAN_SESSION_TTL_MS=300000
FACE_SCAN_MIN_FRAMES=4
FACE_SCAN_MIN_DURATION_MS=4500
FACE_SCAN_STEP_TIMEOUT_MS=20000
FACE_SCAN_MIN_DETECTOR_SCORE=0.55
FACE_SCAN_MIN_BBOX_AREA=12000
FACE_SCAN_MAX_ABS_PITCH=20
FACE_SCAN_MAX_ABS_ROLL=20
FACE_SCAN_LIVENESS_THRESHOLD=0.55

# System Settings
MAX_OVERDUE_MINUTES=15
AUTO_UNLOCK_BEFORE_CLASS=5
NOTIFICATION_BEFORE_CLASS=30

# Redis (optional)
REDIS_ENABLED=true
REDIS_KEY_PREFIX=cms:dev:

# Option A: URL (recommended for Redis Cloud)
REDIS_URL=rediss://default:<YOUR_REDIS_CLOUD_PASSWORD>@redis-16578.crce185.ap-seast-1-1.ec2.cloud.redislabs.com:16578/0

# Option B: host/port credentials
REDIS_HOST=redis-16578.crce185.ap-seast-1-1.ec2.cloud.redislabs.com
REDIS_PORT=16578
REDIS_USERNAME=default
REDIS_PASSWORD=<YOUR_REDIS_CLOUD_PASSWORD>
REDIS_DB=0
REDIS_TLS=true

# Google Drive storage for Incident images
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GDRIVE_INCIDENTS_FOLDER_ID=<YOUR_GOOGLE_DRIVE_FOLDER_ID>

# Optional OAuth upload mode for My Drive (recommended when Service Account hits quota)
# Can reuse GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET if same app
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# Booking reminder worker
BOOKING_APPROVAL_REMINDER_MINUTES=15
BOOKING_APPROVAL_REMINDER_MAX_MINUTES=20
NOTIFICATION_WORKER_CONCURRENCY=5

# Transfer mode (preferred)
# true  = enforce transfer time window (realtime mode)
# false = free-time mode for transfer actions
TRANSFER_REALTIME_MODE=false

# IoT Gateway command dispatch (locker unlock)
IOT_GATEWAY_BASE_URL=http://localhost:4010
IOT_GATEWAY_AUTH_USER=esp32
IOT_GATEWAY_AUTH_PASS=esp32-secret
IOT_GATEWAY_TIMEOUT_MS=4000
# Session Unlock time period
#Note for adding another commit
